<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypers="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hybrid_control_arbitrator</name>
  <version>0.0.0</version>
  <description>Arbitrator node that switches between PilotNet (default) and MPC (critical situations) for the hybrid control mode</description>
  <maintainer email="sezan92@users.noreply.github.com">sezan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>autoware_auto_control_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
